<?xml version='1.0' encoding='utf-8'?>
<widget id="com.trihive.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>TriHive</name>
    <description>Aplikasi Web Chat &amp; Voice/Video Call Mosaik Segitiga</description>
    <author email="admin@trihive.com" href="https://trihive.com">
        Tim TriHive
    </author>
    
    <!-- Halaman Utama Aplikasi -->
    <content src="index.html" />

    <!-- Preferensi dan Pengaturan Tampilan -->
    <preference name="loglevel" value="DEBUG" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xff0b0d12" />
    <preference name="HideSplashScreenSpinner" value="true" />
    <preference name="Orientation" value="portrait" />

    <!-- Konfigurasi Platform Android -->
    <platform name="android">
        <allow-intent href="http://*/*" />
        <allow-intent href="https://*/*" />
        
        <!-- Izin Khusus untuk WAKE_LOCK, Lockscreen, & Foreground Service (Panggilan & Suara) -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest" xmlns:android="http://schemas.android.com/apk/res/android">
            <uses-permission android:name="android.permission.WAKE_LOCK" />
            <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
            <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
        </edit-config>
    </platform>

    <!-- Akses Aksesoris & Web URL Eksternal -->
    <access origin="*" />
    <allow-intent href="tel:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
</widget>
